# ══════════════════════════════════════════════════════════════════
# MicroCoreOS — Environment Variables Reference
# Copy this file to .env and fill in your values.
# ══════════════════════════════════════════════════════════════════

# ─── Twitch App Credentials ────────────────────────────────────────
# Register an app at https://dev.twitch.tv/console/apps
# (Category: any, Client Type: Confidential).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ─── PRODUCTION — docker-compose.prod.yml / docker-compose.selfhost.yml ───
# Only edit APP_PORT. Those compose files compute FRONTEND_URL and
# TWITCH_REDIRECT_URI from it automatically — you don't touch those two
# for this mode (they're set below only as a fallback for other modes).
APP_PORT=80

# ─── DEVELOPMENT — bare `uv run main.py` + `pnpm dev`, no Docker ──────────
# (Using `docker-compose.dev.yml` instead? That mode reads .env.dev, not this file.)
# These two ARE read as-is in this mode — they must match the port your vite
# dev server actually runs on (see vite.config.ts). Change vite's port later?
# Update both lines below to match, or Twitch will keep sending you to the old one.
FRONTEND_URL=http://localhost
TWITCH_REDIRECT_URI=http://localhost/api/auth/twitch/callback

# Whichever mode you're using: register the exact TWITCH_REDIRECT_URI above
# under "OAuth Redirect URLs" in the Twitch console (exact match required —
# you can register all three modes' URLs there at once, no need to pick one).

# --- TTS PROVIDERS ---
# Edge TTS (always active, no config required)
# EDGE_TTS_DEFAULT_VOICE=es-ES-AlvaroNeural

# Voicebox (activate by setting VOICEBOX_HOST)
VOICEBOX_HOST=192.168.1.87
VOICEBOX_PORT=17493
VOICEBOX_JOB_TIMEOUT_S=300   # max seconds to wait per job (default: 300 = 5 min)


# ─── HTTP Server ──────────────────────────────────────────────────
HTTP_PORT=8000

# Bind address. Default: 127.0.0.1 (dev-safe).
# ⚠ DOCKER: must be 0.0.0.0 or nginx cannot reach the backend.
HTTP_HOST=0.0.0.0

# CORS allowed origins. Default: * (allow all — dev-friendly).
# Production: set to your actual frontend domain(s), comma-separated.
# HTTP_CORS_ORIGINS=https://app.example.com,https://admin.example.com

# Uvicorn log level. Default: warning (silent in prod).
# Set to "info" to enable HTTP access logs (method, path, status, latency).
# HTTP_LOG_LEVEL=info



# ─── Authentication ───────────────────────────────────────────────
# Not used by any feature currently. Only needed if you build plugins that use the auth tool.
# AUTH_SECRET_KEY=super-secret-key-change-me-in-production
# AUTH_TOKEN_EXPIRE_MINUTES=60


# ─── Database ─────────────────────────────────────────────────────

# SQLite (default, zero-config — just run uv run main.py)
SQLITE_DB_PATH=database.db

# PostgreSQL (production — swap db tool, see INSTRUCTIONS_FOR_AI.md)
# PG_HOST=localhost
# PG_PORT=5432
# PG_USER=postgres
# PG_PASSWORD=postgres
# PG_DATABASE=microcoreos


# ─── Observability: Metrics ───────────────────────────────────────
# Timing is ALWAYS ON — ToolProxy measures every tool call automatically.
# No config needed. Access via:
#   records = self.registry.get_metrics()
#   self.registry.add_metrics_sink(callback)
# Each record: {tool, method, duration_ms, success, timestamp}


# ─── Observability: Health Check ──────────────────────────────────
# ToolHealthPlugin runs in the background and calls db.health_check()
# periodically, updating the registry status proactively.
HEALTH_CHECK_INTERVAL=30   # seconds between checks (default: 30)


# ─── Observability: OpenTelemetry ─────────────────────────────────
# Disabled by default. When enabled, ALL tool calls get OTel spans
# automatically via ToolProxy — no changes needed in plugins or tools.
#
# Install required packages first:
#   uv add opentelemetry-sdk opentelemetry-exporter-otlp opentelemetry-instrumentation-fastapi
#
OTEL_ENABLED=false
OTEL_SERVICE_NAME=microcoreos

# Export destination — leave commented to use console (dev mode)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317   # Jaeger / Grafana Tempo / any OTLP backend

# BatchSpanProcessor tuning (optional — OTel standard env vars)
# OTEL_BSP_SCHEDULE_DELAY=5000        # ms between export batches (default: 5000)
# OTEL_BSP_MAX_EXPORT_BATCH_SIZE=512  # spans per batch (default: 512)
# OTEL_BSP_MAX_QUEUE_SIZE=2048        # in-memory buffer size (default: 2048)


# ─── Chaos Engineering ────────────────────────────────────────────
# Intentionally fails tools/plugins on boot to test fault tolerance.
# NEVER enable in production.
# CHAOS_ENABLED=true


# ─── Event Bus Transport ───────────────────────────────────────────
# Default: in_process (in-memory, single instance, zero config).
# To go distributed, drop a *_driver.py in tools/event_bus/ (already
# shipped: redis_streams_driver.py, kafka_driver.py, rabbitmq_driver.py)
# and point EVENT_BUS_DRIVER at it — no code changes.
# EVENT_BUS_DRIVER=rabbitmq

# RabbitMQ (see tools/event_bus/rabbitmq_driver.py for the full contract)
# RABBITMQ_HOST=localhost
# RABBITMQ_PORT=5672
# RABBITMQ_USER=guest
# RABBITMQ_PASSWORD=guest
# RABBITMQ_VHOST=/
# RABBITMQ_BUS_EXCHANGE=bus
