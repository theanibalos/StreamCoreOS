FROM node:22-alpine AS builder

RUN apk add --no-cache git && npm install -g pnpm

ARG FRONTEND_REPO=https://github.com/theanibalos/StreamCoreOS-Front.git
ARG FRONTEND_REF=main

RUN git clone --depth=1 --branch ${FRONTEND_REF} ${FRONTEND_REPO} /app

WORKDIR /app
RUN pnpm install --frozen-lockfile --ignore-scripts && node_modules/.bin/vite build

FROM nginx:alpine
COPY --from=builder /app/build /usr/share/nginx/html
COPY --from=builder /app/nginx.conf /etc/nginx/conf.d/default.conf
